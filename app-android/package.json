{
  "name": "alphasun-beihai-mobile",
  "version": "8.1.0",
  "private": true,
  "description": "AlphaSun 北海极端气候全景系统 — 移动端 APP（Capacitor 纯前端封装，支持 iOS + Android，直连权威数据源）",
  "scripts": {
    "build": "echo '静态前端无需构建，www/ 已就绪'",
    "sync": "cap sync",
    "android:init": "cap add android",
    "open:android": "cap open android",
    "build:android": "cap sync && cap build android",
    "ios:init": "cap add ios",
    "open:ios": "cap open ios",
    "build:ios": "cap sync && cap build ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "typescript": "^5.4.5"
  }
}
