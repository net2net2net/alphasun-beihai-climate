# ===== AlphaSun 北海极端气候全景系统 · Git 忽略规则 =====

# 便携 Node 运行时（约 87MB，不入库）
# 其他智能体安装后自备 Node，或从 alphasun-beihai-climate.zip 获取运行时
app/node/

# 日志
*.log

# 临时探针 / 开发残留
_*.js
_*.html
*.tmp

# 依赖与系统
node_modules/
.DS_Store
Thumbs.db

# 编辑器 / 系统缓存
.idea/
.vscode/

# 单文件可执行程序（Node SEA 构建产物，约 87MB，不入库；构建方式见 SKILL.md / 知识库）
app/AlphaSun.exe
*.exe
*.exe1
alphasun-beihai-climate
alphasun-beihai-climate.exe1

# SEA 构建中间产物（由 build-assets.js + esbuild 生成）
app/dist/

# 多源实况校核快照（运行时节流落盘，本地审计缓存，不入库）
data/realtime-check.json

# 本地密钥 / 配置（含和风天气 KEY 等敏感信息，绝不入库；请用 config.example.json 作模板复制为 config.json）
app/config.json
.env
*.local.json

# 智能体工作数据目录（记忆 / 构建产物 APK 副本等，不入库）
.workbuddy/

# 构建产物分发目录（exe / apk 等由 CI 发布到 GitHub Release，本地构建产物不入库）
downloads/

